# ================= FanVerify 后端环境变量示例 =================
# 使用方法：复制为 .env 并填写真实值
#   cp .env.example .env

# ---- 微信小程序 ----
# 小程序 AppID（默认已内置，如需替换可修改）
WX_APPID=wxea50dc0c6b97b784
# 小程序 AppSecret（必填，登录/换 openid 用）
WX_SECRET=你的微信小程序密钥

# ---- 验证码 ----
# 验证码共享密钥（必填，TOTP 签名用，请使用足够长的随机串）
CODE_SECRET=你的验证码共享密钥

# ---- JWT 登录 ----
# JWT 签名密钥（必填，/api/login 签发令牌用，请使用足够长的随机串）
JWT_SECRET=你的JWT签名密钥
# ip2region 外部 IP 库路径（可选）
# 默认已内嵌进二进制，无需配置；如需使用外部库（不重编译更新库）可指定路径
# 从 https://github.com/lionsoul2014/ip2region/releases 下载 ip2region.xdb
# IP2REGION_DB=/opt/fanverify/ip2region.xdb

# ---- 人机验证 ----
# CAPTCHA 服务密钥（必填，/api/login 与 /api/getmoneylist 人机验证用）
CAP_SECRET=你的cap人机验证密钥

# ---- 服务 ----
# 运行端口（默认 8888）
PORT=8888
# 数据库模式：ok=MySQL(生产) / test=SQLite(测试)
STATUS=test
# 是否开启 Debug 接口：true/false
DEBUG=false
# 是否开启开发者业务保活检测计划任务：true/false
# true 后每 2 小时(00:00~22:00 共 12 个整点)检测一次待审业务；12 次中成功 >=8 次即通过并颁发密钥
USER_PLAN_MODE=false

# ---- CORS（可选） ----
# 额外允许的跨域来源（逗号分隔），默认仅 fanverify.cn 主域名及子域名
# 本地开发时可追加，如：CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_ORIGINS=

# ---- 腾讯云短信（升级二级验证发验证码用）----
# 腾讯云密钥（需开通短信服务）
TC_SECRET_ID=
TC_SECRET_KEY=
# 短信应用 SDKAppID（控制台-短信-应用管理）
TC_SMS_APP_ID=
# 短信签名（需审核通过，如 FanVerify）
TC_SMS_SIGN=
# 验证码短信模板 ID（需审核通过，模板内容含 {1} 验证码变量）
TC_SMS_TEMPLATE=

# ---- MySQL（仅 STATUS=ok 时需要）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=fanverify
